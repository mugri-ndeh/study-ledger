# Paste these into Portainer → your stack → Environment variables (one per row).
# Never commit real values.
APP_IMAGE=yourdockerhubname/study-ledger:latest
POSTGRES_PASSWORD=a-long-random-password
# The port on the server the app is reachable on.
APP_PORT=8000
# true once the site is served over HTTPS (behind Nginx Proxy Manager, Traefik, Caddy, Cloudflare Tunnel...).
COOKIE_SECURE=false
SIGNUP_ENABLED=true
MARKET_MAX_AGE_DAYS=7
